# Copy to .env and fill in real values. Never commit .env.

# Server
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/jobportal
JWT_SECRET=replace-with-a-long-random-string

# Email (nodemailer) — used for welcome, application confirmation, status updates
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=

# Cloudinary (resume and profile image storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Gemini
# Server-side only. Never expose this key to the frontend.
GEMINI_API_KEY=
# Primary model used for both AI features.
GEMINI_MODEL=gemini-3.8-flash
# Optional. Only used when the primary model returns a temporary availability
# error (503 / UNAVAILABLE / high demand). Auth, permission, malformed-request,
# invalid-model and quota (429) errors are never retried on another model.
# Leave unset to use the built-in default: gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Shared hourly budget for all Gemini-backed features (resume analysis and job
# match combined).
AI_ANALYSIS_HOURLY_LIMIT=3

# Adzuna Jobs API (external job listings)
# Get credentials from https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in